table 'Measures (2)'
	lineageTag: 1f13b694-e69c-4a9c-9795-231ab7187b3d

	measure Enrollment = SUM(FactEnrollmentSummary[Enrollment])
		formatString: 0
		lineageTag: 0e2b3758-bd17-4aae-8c27-63c12a832859

		changedProperty = IsHidden

	measure 'Total Enrollment' =
			
			CALCULATE(
			    [Enrollment],
			    FactEnrollmentSummary[StudentLevel] = "All Students"
			)
		formatString: 0
		lineageTag: ac391b37-455c-4a17-bef2-56cdfd9e0aa9

		changedProperty = IsHidden

	measure 'Undergraduate Enrollment' =
			
			CALCULATE(
			    [Enrollment],
			    FactEnrollmentSummary[StudentLevel] = "Undergraduate"
			)
		formatString: 0
		lineageTag: aa2bfeea-2181-47d2-aa72-2eb180ff3547

		changedProperty = IsHidden

	measure 'Graduate Enrollment' =
			
			CALCULATE(
			    [Enrollment],
			    FactEnrollmentSummary[StudentLevel] = "Graduate"
			)
		formatString: 0
		lineageTag: d2a5c66e-10f5-4d16-a663-c3ab105c44d5

		changedProperty = IsHidden

	measure 'Detailed Enrollment' = SUM(FactEnrollmentDetail[Enrollment])
		formatString: 0
		lineageTag: 946599ad-527d-4a98-b4aa-4028eb806995

		changedProperty = IsHidden

	measure 'Latest Enrollment Year' =
			
			MAXX(
			    ALL(DimFallTerm),
			    DimFallTerm[Year]
			)
		formatString: 0
		lineageTag: 8a9de536-c014-462e-9333-c18642e722f3

		changedProperty = IsHidden

	measure 'Latest Total Enrollment' =
			
			VAR LatestYear = [Latest Enrollment Year]
			RETURN CALCULATE(
			    [Total Enrollment],
			    DimFallTerm[Year] = LatestYear
			)
		formatString: 0
		lineageTag: 734e762c-f979-4c0b-be44-dc3a1a408b20

		changedProperty = IsHidden

	measure 'Latest Undergraduate Enrollment' =
			
			VAR LatestYear = [Latest Enrollment Year]
			RETURN CALCULATE(
			    [Undergraduate Enrollment],
			    DimFallTerm[Year] = LatestYear
			)
		formatString: 0
		lineageTag: e94b8b2d-48e3-4742-9d58-5d64155955f4

		changedProperty = IsHidden

	measure 'Latest Graduate Enrollment' =
			
			VAR LatestYear = [Latest Enrollment Year]
			RETURN CALCULATE(
			    [Graduate Enrollment],
			    DimFallTerm[Year] = LatestYear
			)
		formatString: 0
		lineageTag: 417df597-1cd2-4ec4-a26b-7c1b1b91e71c

		changedProperty = IsHidden

	measure 'Previous Reported Enrollment Year' =
			
			VAR LatestYear = [Latest Enrollment Year]
			RETURN MAXX(
			    FILTER(
			        ALL(DimFallTerm),
			        DimFallTerm[Year] < LatestYear
			    ),
			    DimFallTerm[Year]
			)
		formatString: 0
		lineageTag: b06677f5-dcc6-4cc6-a12b-3addfaf1eaa2

	measure 'Previous Total Enrollment' =
			
			VAR PreviousReportedYear = [Previous Reported Enrollment Year]
			RETURN CALCULATE(
			    [Total Enrollment],
			    REMOVEFILTERS(DimFallTerm),
			    DimFallTerm[Year] = PreviousReportedYear
			)
		formatString: 0
		lineageTag: 1ca981e9-d137-4cc8-9f34-b3e8a21785e5

	measure 'Latest Enrollment Change' = [Latest Total Enrollment] - [Previous Total Enrollment]
		formatString: 0
		lineageTag: 287f3988-cabd-4cf0-b584-661afb4caac4

	measure 'Latest Enrollment Change %' =
			
			DIVIDE(
			    [Latest Enrollment Change],
			    [Previous Total Enrollment]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 341e0b56-66e7-4b79-9de9-fa1bc7c9cded

	measure 'Latest Enrollment Change Display' =
			
			FORMAT(
			    [Latest Enrollment Change %],
			    "+0.0%;-0.0%;0.0%"
			)
		lineageTag: a15aa8c9-6f42-4474-b5a3-18f12898fe97

	measure 'Enrollment Share' =
			
			DIVIDE(
			    [Detailed Enrollment],
			    CALCULATE(
			        [Detailed Enrollment],
			        REMOVEFILTERS(FactEnrollmentDetail[Category])
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 15963e16-6497-4dbe-a4ae-1a6938c3ffc4

	measure 'Selected Focus Year' =
			
			SELECTEDVALUE(
			    DimFallTerm[Year],
			    [Latest Enrollment Year]
			)
		formatString: 0
		lineageTag: 2e4847f3-1b39-414f-b88c-0f0cc2ad0dae

	measure 'Category Snapshot Title' =
			
			VAR FocusYear = [Selected Focus Year]
			VAR StdntLevel =
			    SELECTEDVALUE(
			        FactEnrollmentDetail[StudentLevel],
			        "All Student Levels"
			    )
			RETURN
			    "Fall " & FORMAT(FocusYear, "0")
			    & " Enrollment by Category"
			    & IF(
			        StdntLevel <> "All Student Levels",
			        " — " & StdntLevel,
			        ""
			    )
		lineageTag: 7851c111-3868-4e58-8ee4-5d01821f0923

	measure 'Composition Trend Title' =
			
			VAR StdntLevel =
			    SELECTEDVALUE(
			        FactEnrollmentDetail[StudentLevel],
			        "All Student Levels"
			    )
			RETURN
			    IF(
			        StdntLevel = "All Student Levels",
			        "Enrollment Share by Category Over Time",
			        StdntLevel & " Enrollment Share by Category Over Time"
			    )
		lineageTag: 99244b08-170d-46ca-95d7-edf19c23ae39

	partition 'Measures (2)' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i45WMlSKjQUA", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Placeholder = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Placeholder", Int64.Type}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Placeholder"})
				in
				    #"Removed Columns"

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

